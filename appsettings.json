{
  "Serilog" :
  {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": 
    {
      "Default": "Information",
      "Override": 
      {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo":[
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args":
        {
          "path": "logs/note-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "NoteLimits":
  {
    "TitleMaxLength": 200,
    "ContentMaxLength": 5000,
    "TagNameMaxLength": 50
  },
  "ConnectionStrings": 
  {
    "Default": "Host=localhost;Port=5432;Database=notesdb;Username=postgres;Password=CHANGE_ME"
  },
  "AllowedHosts": "*"

}
